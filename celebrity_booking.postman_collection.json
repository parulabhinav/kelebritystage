  "item": [
    {
      "name": "1. Public (No Auth)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "health"]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "categories"]
            }
          }
        },
        {
          "name": "Discover Celebrities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/celebrities?category=Musician&minPrice=10000&maxPrice=50000&search=Rohan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "celebrities"],
              "query": [
                { "key": "category", "value": "Musician" },
                { "key": "minPrice", "value": "10000" },
                { "key": "maxPrice", "value": "50000" },
                { "key": "search", "value": "Rohan" }
              ]
            }
          }
        },
        {
          "name": "Get Celebrity Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/celebrities/{{celebrityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "celebrities", "{{celebrityId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+918888888888\",\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
